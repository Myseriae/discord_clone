# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_DB=discordclone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port for Postgres (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5433

# --- API ---
ASPNETCORE_ENVIRONMENT=Production

# JWT signing key — REQUIRED. Use a strong random value of at least 32 characters.
# Generate one, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-key-at-least-32-chars
